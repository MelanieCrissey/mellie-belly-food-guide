---
import '../styles/global.css';
---

<header class="bg-brand-black text-white py-10 px-4 border-b-4 border-brand-pink">
  <div class="max-w-7xl mx-auto">
      <h1 class="font-display text-4xl md:text-6xl font-black uppercase tracking-tight leading-none">
        Mellie Belly's <span class="text-brand-pink">UNOFFICIAL</span> <br/> RenderATL Restaurant Guide
      </h1>
      <p class="font-display text-xl md:text-2xl font-bold uppercase tracking-wider text-brand-yellow mt-2">
        RenderATL 2026
      </p>
      <p class="text-white/70 text-lg mt-1 font-body">Where to eat while you're in town for <a href="https://www.renderatl.com/" class="text-white underline" target="_blank" rel="noopener noreferrer">RenderATL 2026 ↗</a> 🍑</p>
    </div>
  </div>
</header>

<style>
  .bg-brand-black {
    background-color: var(--color-brand-black);
  }
  .border-brand-pink {
    border-color: var(--color-brand-pink);
  }
  .bg-brand-pink {
    background-color: var(--color-brand-pink);
  }
  .text-brand-pink {
    color: var(--color-brand-pink);
  }
  .bg-brand-yellow {
    background-color: var(--color-brand-yellow);
  }
  .text-brand-yellow {
    color: var(--color-brand-black);
  }
  .border-brand-black {
    border-color: var(--color-brand-black);
  }
  .bg-brand-teal {
    background-color: var(--color-brand-teal);
  }
</style>
