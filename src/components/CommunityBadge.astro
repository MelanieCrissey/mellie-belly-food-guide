---
interface CommunityCredit {
  name: string;
  url?: string;
}

interface CommunityBadgeProps {
  contributed: boolean;
  credit?: CommunityCredit;
}

const { contributed, credit } = Astro.props;

if (!contributed) return null;
---

<span class="inline-flex items-center gap-1.5">
  <svg class="w-4 h-4 text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/>
  </svg>
  {credit ? (
    credit.url ? (
      <span class="text-xs font-semibold">Thank you, <a href={credit.url} target="_blank" rel="noopener noreferrer" class="text-brand-teal underline underline-offset-2 hover:opacity-80" onclick="event.stopPropagation()">{credit.name}</a>!</span>
    ) : (
      <span class="text-xs font-semibold">Thank you, {credit.name}!</span>
    )
  ) : (
    <span class="text-xs font-semibold">Community Contributed</span>
  )}
</span>
