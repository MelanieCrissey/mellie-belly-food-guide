---
import MellieBadge from './MellieBadge.astro';

interface RestaurantCardProps {
  restaurant: {
    id: string;
    name: string;
    category: string;
    rating: number;
    priceLevel: number;
    mellieVerified: boolean;
    mellieDescription: string;
    description: string;
    bestFor: string[];
    address: string;
    lat: number;
    lng: number;
    instagram: string;
    michelin: string;
    heroImage: string;
  };
}

const { restaurant } = Astro.props;

const priceString = "$".repeat(restaurant.priceLevel);
const googleMapsUrl = `https://www.google.com/maps/dir/?api=1&origin=230+John+Portman+Blwd+NW+Building+2,+Atlanta,+GA+30303&destination=${encodeURIComponent(restaurant.address)}`;
const googleSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(restaurant.name + ', ' + restaurant.address)}`;
---

<div 
  class="restaurant-card group bg-white border-2 border-brand-black shadow-brutal-hover cursor-pointer category-{restaurant.category} overflow-hidden relative"
  data-restaurant-id={restaurant.id}
  data-restaurant-json={JSON.stringify(restaurant)}
>
  {restaurant.heroImage ? (
    <div class="relative w-full aspect-[16/9] overflow-hidden border-b-2 border-brand-black">
      <img 
        src={restaurant.heroImage} 
        alt={restaurant.name}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    </div>
  ) : null}
  <div class="p-4">
    <div class="flex items-start justify-between mb-2">
      <h3 class="font-display text-lg font-bold uppercase tracking-tight text-brand-black leading-tight">{restaurant.name}</h3>
      <span class="font-display text-brand-black font-black text-sm ml-2 shrink-0">{priceString}</span>
    </div>
    
    <div class="flex items-center gap-2 mb-2 flex-wrap">
      <a 
        href={googleSearchUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 hover:opacity-80 transition-opacity"
        onclick="event.stopPropagation()"
      >
        <span class="text-brand-yellow text-sm">{'★'.repeat(Math.floor(restaurant.rating))}</span>
        <span class="text-gray-500 text-xs">({restaurant.rating.toFixed(1)})</span>
      </a>
      <MellieBadge verified={restaurant.mellieVerified} description={restaurant.mellieDescription} />
    </div>

    <p class="text-gray-600 text-sm mb-3 line-clamp-2">{restaurant.description}</p>

    <div class="flex items-center gap-1 mb-3">
      <a 
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-700 hover:underline text-xs flex items-center gap-1"
        onclick="event.stopPropagation()"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        {restaurant.address}
      </a>
      <button
        class="copy-address-btn shrink-0 text-gray-400 hover:text-brand-pink transition-colors cursor-pointer"
        data-address={restaurant.address}
        data-restaurant-id={restaurant.id}
        data-restaurant-name={restaurant.name}
        onclick="event.stopPropagation(); navigator.clipboard.writeText(this.dataset.address).then(() => { window.posthog?.capture('restaurant_address_copied', { restaurant_id: this.dataset.restaurantId, restaurant_name: this.dataset.restaurantName }); this.querySelector('.copy-icon').classList.add('hidden'); this.querySelector('.check-icon').classList.remove('hidden'); setTimeout(() => { this.querySelector('.copy-icon').classList.remove('hidden'); this.querySelector('.check-icon').classList.add('hidden'); }, 1500); })"
        aria-label="Copy address"
      >
        <svg class="w-3.5 h-3.5 copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <svg class="w-3.5 h-3.5 check-icon hidden text-brand-teal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
      </button>
    </div>

    <div class="flex items-center gap-4 mb-3">
      {restaurant.instagram ? (
        <a
          href={restaurant.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-gray-500 hover:text-brand-pink transition-colors"
          data-restaurant-id={restaurant.id}
          data-restaurant-name={restaurant.name}
          onclick="event.stopPropagation(); window.posthog?.capture('restaurant_instagram_clicked', { restaurant_id: this.dataset.restaurantId, restaurant_name: this.dataset.restaurantName })"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <span class="text-xs">Instagram</span>
        </a>
      ) : null}
      {restaurant.michelin ? (
        <a
          href={restaurant.michelin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-gray-500 hover:text-brand-pink transition-colors"
          data-restaurant-id={restaurant.id}
          data-restaurant-name={restaurant.name}
          onclick="event.stopPropagation(); window.posthog?.capture('restaurant_michelin_clicked', { restaurant_id: this.dataset.restaurantId, restaurant_name: this.dataset.restaurantName })"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span class="text-xs">Michelin</span>
        </a>
      ) : null}
    </div>

    <div class="flex flex-wrap gap-1.5">
      {restaurant.bestFor.map((tag: string) => (
        <span class="tag">
          {tag.replace("-", " ")}
        </span>
      ))}
    </div>
  </div>
</div>
