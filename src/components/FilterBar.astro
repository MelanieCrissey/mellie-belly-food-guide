---
import restaurants from '../data/restaurants.json';

// Count tag occurrences and only show tags used 2+ times
const tagCounts = restaurants.flatMap(r => r.bestFor).reduce((acc: Record<string, number>, tag: string) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {} as Record<string, number>);
const pinnedOrder = ['breakfast', 'lunch', 'dinner'];
const allTags = Object.entries(tagCounts)
  .filter(([_, count]) => count >= 2)
  .map(([tag]) => tag)
  .sort((a, b) => {
    const ai = pinnedOrder.indexOf(a);
    const bi = pinnedOrder.indexOf(b);
    if (ai !== -1 && bi !== -1) return ai - bi;
    if (ai !== -1) return -1;
    if (bi !== -1) return 1;
    return a.localeCompare(b);
  });
const priceLevels = [1, 2, 3, 4];
---

<div class="sticky top-0 z-40 bg-white border-b-2 border-brand-black py-3 px-4 shadow-md" id="filter-bar">
  <div class="max-w-7xl mx-auto">
    <!-- Toggle button and map link -->
    <div class="flex items-center gap-4">
      <button
        id="filter-toggle"
        class="flex items-center gap-2 font-display text-sm font-bold uppercase tracking-wider text-brand-black cursor-pointer hover:text-brand-pink transition-colors"
        aria-expanded="false"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          <circle cx="8" cy="6" r="2" fill="currentColor" stroke="none"/>
          <circle cx="14" cy="12" r="2" fill="currentColor" stroke="none"/>
          <circle cx="10" cy="18" r="2" fill="currentColor" stroke="none"/>
        </svg>
        <span>Filter</span>
        <svg class="w-3 h-3 transition-transform duration-200" id="filter-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>

      <a
        href="/map"
        class="flex items-center gap-2 font-display text-sm font-bold uppercase tracking-wider text-brand-black hover:text-brand-pink transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
        </svg>
        <span>Map</span>
      </a>
    </div>

    <!-- Collapsible filter options -->
    <div id="filter-options" class="hidden mt-3 flex flex-col gap-3">
      <!-- Price Filter -->
      <div class="flex items-center gap-4 flex-wrap">
        <span class="font-display text-sm font-bold uppercase tracking-wider text-brand-black shrink-0">Price:</span>
        <div class="flex gap-3 flex-wrap">
          {priceLevels.map((level) => (
            <button
              class="filter-price-btn font-display text-sm font-bold cursor-pointer transition-colors"
              data-price={level}
              aria-pressed="false"
            >
              {'$'.repeat(level)}
            </button>
          ))}
        </div>
      </div>

      <!-- Tag Filter -->
      <div class="flex items-center gap-3 flex-wrap">
        <span class="font-display text-sm font-bold uppercase tracking-wider text-brand-black shrink-0">Vibe:</span>
        <div class="flex gap-1.5 flex-wrap">
          {allTags.map((tag) => (
            <button
              class="filter-tag-btn tag cursor-pointer hover:opacity-80 transition-opacity"
              data-tag={tag}
              aria-pressed="false"
            >
              {tag.replaceAll("-", " ")}
            </button>
          ))}
        </div>
      </div>

      <!-- Results count and clear (always holds space) -->
      <div class="flex items-center gap-4 h-6">
        <span id="filter-results-count" class="invisible font-display text-sm font-bold text-brand-black"></span>
        <button
          id="clear-filters"
          class="invisible font-display text-xs font-bold uppercase tracking-wider text-brand-pink underline cursor-pointer hover:text-brand-black transition-colors"
        >
          Clear all filters
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .filter-price-btn[aria-pressed="false"] {
    color: var(--color-brand-black);
    opacity: 0.5;
  }

  .filter-price-btn[aria-pressed="true"] {
    color: var(--color-brand-black);
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-brand-pink);
    text-decoration-thickness: 2px;
  }

  .filter-price-btn:hover {
    opacity: 1;
  }

  .filter-tag-btn[aria-pressed="false"] {
    background: white;
    color: var(--color-brand-black);
    border-color: #000;
  }

  .filter-tag-btn[aria-pressed="true"] {
    background: var(--color-brand-yellow);
    color: var(--color-brand-black);
    border-color: #000;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterToggle = document.getElementById('filter-toggle');
    const filterOptions = document.getElementById('filter-options');
    const filterChevron = document.getElementById('filter-chevron');
    const priceButtons = document.querySelectorAll('.filter-price-btn');
    const tagButtons = document.querySelectorAll('.filter-tag-btn');
    const clearButton = document.getElementById('clear-filters');
    const resultsCount = document.getElementById('filter-results-count');
    const restaurantCards = document.querySelectorAll('.restaurant-card');
    const categorySections = document.querySelectorAll('main section[id]');

    let activePrices: Set<number> = new Set();
    let activeTags: Set<string> = new Set();

    function expandPanel() {
      filterToggle?.setAttribute('aria-expanded', 'true');
      filterOptions?.classList.remove('hidden');
      filterChevron?.style.setProperty('transform', 'rotate(180deg)');
    }

    function collapsePanel() {
      filterToggle?.setAttribute('aria-expanded', 'false');
      filterOptions?.classList.add('hidden');
      filterChevron?.style.setProperty('transform', '');
    }

    // Toggle filter panel — only allow closing if no filters are active
    filterToggle?.addEventListener('click', () => {
      const isExpanded = filterToggle.getAttribute('aria-expanded') === 'true';
      const hasFilters = activePrices.size > 0 || activeTags.size > 0;

      if (isExpanded && !hasFilters) {
        collapsePanel();
      } else if (!isExpanded) {
        expandPanel();
      }
    });

    function updateFilters() {
      const hasFilters = activePrices.size > 0 || activeTags.size > 0;
      clearButton?.classList.toggle('invisible', !hasFilters);
      resultsCount?.classList.toggle('invisible', !hasFilters);

      // Keep panel open while filters are active
      if (hasFilters) {
        expandPanel();
      }

      let visibleCount = 0;
      restaurantCards.forEach((card) => {
        const data = JSON.parse((card as HTMLElement).dataset.restaurantJson || '{}');
        
        const priceMatch = activePrices.size === 0 || activePrices.has(data.priceLevel);
        const tagMatch = activeTags.size === 0 || data.bestFor?.some((t: string) => activeTags.has(t));

        const visible = priceMatch && tagMatch;
        (card as HTMLElement).style.display = visible ? '' : 'none';
        if (visible) visibleCount++;
      });

      if (resultsCount) {
        resultsCount.textContent = `${visibleCount} result${visibleCount !== 1 ? 's' : ''}`;
      }

      // Hide category sections where all cards are hidden
      categorySections.forEach((section) => {
        const cards = section.querySelectorAll('.restaurant-card');
        const anyVisible = Array.from(cards).some(
          (card) => (card as HTMLElement).style.display !== 'none'
        );
        (section as HTMLElement).style.display = anyVisible ? '' : 'none';
      });
    }

    priceButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const price = parseInt((btn as HTMLElement).dataset.price || '0');
        if (activePrices.has(price)) {
          activePrices.delete(price);
          btn.setAttribute('aria-pressed', 'false');
        } else {
          activePrices.add(price);
          btn.setAttribute('aria-pressed', 'true');
        }
        updateFilters();
      });
    });

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = (btn as HTMLElement).dataset.tag || '';
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          btn.setAttribute('aria-pressed', 'false');
        } else {
          activeTags.add(tag);
          btn.setAttribute('aria-pressed', 'true');
        }
        updateFilters();
      });
    });

    clearButton?.addEventListener('click', () => {
      activePrices.clear();
      activeTags.clear();
      priceButtons.forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
      tagButtons.forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
      updateFilters();
    });
  });
</script>
