<div id="map-container" class="h-96 md:h-[500px] w-full rounded-lg shadow-md overflow-hidden z-10">
  <div id="map" class="h-full w-full"></div>
</div>

<div id="map-filters" class="flex flex-wrap gap-2 mt-4">
  <button class="filter-btn active bg-amber-500 text-white px-3 py-1.5 rounded-full text-sm font-medium transition-colors" data-category="all">
    All
  </button>
  <button class="filter-btn bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium transition-colors hover:bg-amber-100" data-category="near-venue">
    Near Venue
  </button>
  <button class="filter-btn bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium transition-colors hover:bg-amber-100" data-category="short-ride">
    Short Ride
  </button>
  <button class="filter-btn bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium transition-colors hover:bg-amber-100" data-category="soul-food">
    Soul Food
  </button>
  <button class="filter-btn bg-white text-gray-700 px-3 py-1.5 rounded-full text-sm font-medium transition-colors hover:bg-amber-100" data-category="spend-maxxing">
    Budget Maxxing
  </button>
</div>

<script>
  import restaurants from '../data/restaurants.json';
  
  const HOTEL_COORDS: [number, number] = [33.7614, -84.3891];
  
  const categoryColors: Record<string, string> = {
    'near-venue': '#F59E0B',
    'short-ride': '#3B82F6',
    'soul-food': '#8B5CF6',
    'spend-maxxing': '#EF4444'
  };

  let map: L.Map | null = null;
  let markers: L.Marker[] = [];
  let allMarkers: L.Marker[] = [];

  function initMap() {
    if (typeof window === 'undefined') return;
    
    const L = (window as any).L;
    if (!L) {
      setTimeout(initMap, 100);
      return;
    }

    map = L.map('map').setView(HOTEL_COORDS, 14);
    
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Hotel marker
    const hotelIcon = L.divIcon({
      html: `<div style="background:#1E3A5F;color:white;padding:4px 8px;border-radius:16px;font-size:12px;font-weight:bold;box-shadow:0 2px 8px rgba(0,0,0,0.3);white-space:nowrap;">📍 RenderATL</div>`,
      className: '',
      iconSize: [120, 30],
      iconAnchor: [60, 15]
    });
    L.marker(HOTEL_COORDS, { icon: hotelIcon }).addTo(map);

    // Restaurant markers
    restaurants.forEach((restaurant) => {
      const color = categoryColors[restaurant.category] || '#F59E0B';
      
      let markerIcon: any;
      if (restaurant.mellieVerified) {
        markerIcon = L.divIcon({
          html: `<div style="background:${color};border:3px solid #D4A017;border-radius:50%;width:24px;height:24px;box-shadow:0 2px 8px rgba(0,0,0,0.3);"></div>`,
          className: '',
          iconSize: [24, 24],
          iconAnchor: [12, 12]
        });
      } else {
        markerIcon = L.divIcon({
          html: `<div style="background:${color};border-radius:50%;width:18px;height:18px;box-shadow:0 2px 6px rgba(0,0,0,0.3);"></div>`,
          className: '',
          iconSize: [18, 18],
          iconAnchor: [9, 9]
        });
      }

      const popupContent = `
          <div style="font-family:system-ui,sans-serif;">
            <strong style="font-size:14px;">${restaurant.name}</strong><br>
            <span style="color:#F59E0B;">${'$'.repeat(restaurant.priceLevel)}</span>
            <span style="color:#666;font-size:12px;"> (${restaurant.rating.toFixed(1)})</span><br>
            <a href="https://www.google.com/maps/dir/?api=1&origin=230+John+Portman+Blwd+NW+Building+2,+Atlanta,+GA+30303&destination=${encodeURIComponent(restaurant.address)}"
               target="_blank"
               rel="noopener noreferrer"
               style="color:#3B82F6;font-size:12px;">
              ${restaurant.address}
            </a><br>
            <a href="https://www.google.com/maps/dir/?api=1&origin=230+John+Portman+Blwd+NW+Building+2,+Atlanta,+GA+30303&destination=${restaurant.lat},${restaurant.lng}" 
               target="_blank" 
               rel="noopener noreferrer"
               style="color:#3B82F6;font-size:12px;text-decoration:underline;">
              Get Directions
            </a>
          </div>
        `;

      const marker = L.marker([restaurant.lat, restaurant.lng], { icon: markerIcon })
        .addTo(map)
        .bindPopup(popupContent);

      marker.on('click', () => {
        const card = document.querySelector(`[data-restaurant-id="${restaurant.id}"]`);
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          (card as HTMLElement).style.boxShadow = '0 0 0 3px #F59E0B';
          setTimeout(() => {
            (card as HTMLElement).style.boxShadow = '';
          }, 2000);
        }
      });

      allMarkers.push(marker);
    });
  }

  // Filter controls
  document.addEventListener('DOMContentLoaded', () => {
    initMap();

    const filterBtns = document.querySelectorAll('.filter-btn');
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-amber-500', 'text-white');
          b.classList.add('bg-white', 'text-gray-700');
        });
        btn.classList.add('active', 'bg-amber-500', 'text-white');
        btn.classList.remove('bg-white', 'text-gray-700');

        const category = btn.getAttribute('data-category');
        allMarkers.forEach(marker => {
          const popupContent = marker.getPopup()?.getContent() as string;
          if (!popupContent) return;
          
          if (category === 'all') {
            marker.addTo(map!);
          } else {
            const restaurant = restaurants.find(r => 
              popupContent.includes(r.name) && r.category === category
            );
            if (restaurant) {
              marker.addTo(map!);
            } else {
              map!.removeLayer(marker);
            }
          }
        });
      });
    });
  });

  // Card click to open modal
  document.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest('.restaurant-card');
    if (!card) return;

    const json = card.getAttribute('data-restaurant-json');
    if (!json) return;

    const restaurant = JSON.parse(json);
    openModal(restaurant);
  });

  function openModal(restaurant: any) {
    const modal = document.getElementById('restaurant-modal');
    if (!modal) return;

    (modal.querySelector('#modal-name') as HTMLElement).textContent = restaurant.name;
    (modal.querySelector('#modal-address-text') as HTMLElement).textContent = restaurant.address;
    (modal.querySelector('#modal-address') as HTMLAnchorElement).href = `https://www.google.com/maps/dir/?api=1&origin=230+John+Portman+Blwd+NW+Building+2,+Atlanta,+GA+30303&destination=${encodeURIComponent(restaurant.address)}`;
    
    // Copy address button
    const copyBtn = modal.querySelector('#modal-copy-address') as HTMLButtonElement;
    if (copyBtn) {
      const newCopyBtn = copyBtn.cloneNode(true) as HTMLButtonElement;
      copyBtn.parentNode?.replaceChild(newCopyBtn, copyBtn);
      newCopyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(restaurant.address).then(() => {
          newCopyBtn.querySelector('.copy-icon')?.classList.add('hidden');
          newCopyBtn.querySelector('.check-icon')?.classList.remove('hidden');
          setTimeout(() => {
            newCopyBtn.querySelector('.copy-icon')?.classList.remove('hidden');
            newCopyBtn.querySelector('.check-icon')?.classList.add('hidden');
          }, 1500);
        });
      });
    }

    (modal.querySelector('#modal-description') as HTMLElement).textContent = restaurant.description;
    (modal.querySelector('#modal-rating') as HTMLElement).textContent = 
      `${'★'.repeat(Math.floor(restaurant.rating))} (${restaurant.rating.toFixed(1)})`;
    (modal.querySelector('#modal-price') as HTMLElement).textContent = '$'.repeat(restaurant.priceLevel);

    // Hero image
    const heroSection = modal.querySelector('#modal-hero-image');
    const heroImg = modal.querySelector('#modal-hero-img') as HTMLImageElement;
    if (restaurant.heroImage) {
      heroImg.src = restaurant.heroImage;
      heroImg.alt = restaurant.name;
      heroSection?.classList.remove('hidden');
    } else {
      heroSection?.classList.add('hidden');
    }

    // Social links
    const socialSection = modal.querySelector('#modal-social');
    let socialHTML = '';
    if (restaurant.instagram) {
      socialHTML += `
        <a href="${restaurant.instagram}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-pink-600 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          Instagram
        </a>
      `;
    }
    if (restaurant.michelin) {
      socialHTML += `
        <a href="${restaurant.michelin}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-gray-600 hover:text-red-600 transition-colors">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          Michelin Guide
        </a>
      `;
    }
    socialSection.innerHTML = socialHTML;

    const mellieSection = modal.querySelector('#modal-mellie');
    if (restaurant.mellieVerified && restaurant.mellieDescription) {
      mellieSection.innerHTML = `
        <div class="bg-pink-50 border border-brand-pink rounded-none p-4">
          <div class="flex items-center gap-2 mb-2">
            <img src="/mellie-verified.svg" alt="Mellie Verified" class="w-6 h-6" />
            <h3 class="font-display font-bold text-brand-pink uppercase">Mellie Says</h3>
          </div>
          <p class="text-gray-700 text-sm">${restaurant.mellieDescription}</p>
        </div>
      `;
      mellieSection.classList.remove('hidden');
    } else {
      mellieSection.classList.add('hidden');
    }

    const bestForContainer = modal.querySelector('#modal-best-for');
    bestForContainer.innerHTML = restaurant.bestFor
      .map((tag: string) => `<span class="bg-amber-100 text-amber-800 text-xs px-3 py-1.5 rounded-full capitalize">${tag.replace(/-/g, ' ')}</span>`)
      .join('');

    const directionsLink = modal.querySelector('#modal-directions') as HTMLAnchorElement;
    directionsLink.href = `https://www.google.com/maps/dir/?api=1&origin=230+John+Portman+Blwd+NW+Building+2,+Atlanta,+GA+30303&destination=${encodeURIComponent(restaurant.address)}`;

    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.querySelector('.modal-backdrop')?.classList.add('opacity-100');
      modal.querySelector('.modal-content')?.classList.add('translate-y-0', 'opacity-100');
    }, 10);
  }

  function closeModal() {
    const modal = document.getElementById('restaurant-modal');
    if (!modal) return;

    modal.querySelector('.modal-backdrop')?.classList.remove('opacity-100');
    modal.querySelector('.modal-content')?.classList.remove('translate-y-0', 'opacity-100');
    
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }

  // Close modal handlers
  document.addEventListener('click', (e) => {
    const modal = document.getElementById('restaurant-modal');
    if (!modal || !modal.classList.contains('hidden')) return;

    if ((e.target as HTMLElement).closest('#modal-close') || 
        (e.target as HTMLElement).classList.contains('modal-backdrop')) {
      closeModal();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
